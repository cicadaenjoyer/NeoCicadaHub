---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Button from "../ui/Button.astro";

interface Props { job: CollectionEntry<"jobs"> }
const { job } = Astro.props;
---
<a class="panel nowcard" href="/work/">
  <span class="logo"><Image src={job.data.logo} alt="" width={112} /></span>
  <span><b>{job.data.title}</b><small>{job.data.org} · current role</small></span>
  <Button variant="w" size="sm" as="span">Work history ›</Button>
</a>

<style>
  .nowcard { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 10px 12px; text-align: left; width: 100%; text-decoration: none; }
  .nowcard b { display: block; font-weight: 800; }
  .nowcard small { color: var(--ink-2); font-weight: 600; }
</style>
