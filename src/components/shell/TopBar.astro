---
import { getEntry } from "astro:content";
import BackButton from "./BackButton.astro";
import type { Screen } from "../../layouts/AppShell.astro";

interface Props {
  screen: Screen;
  title: string;
}
const { screen, title } = Astro.props;
const site = (await getEntry("site", "main"))!.data;
// The top-bar title is the page's <h1>, except on Home (the lobby name is the h1) and 404 (the panel holds it).
const titleIsHeading = screen !== "home" && screen !== "notfound";
---
<header class="top">
  <div class="tl">
    {screen !== "home" && <BackButton />}
    <div class="ttl">
      {titleIsHeading ? <h1 class="ttl-t">{title}</h1> : <p class="ttl-t">{title}</p>}
    </div>
  </div>
  <div class="caps">
    <a class="cap" href={site.github} target="_blank" rel="noopener" aria-label="GitHub (opens in a new tab)">
      <span class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A10 10 0 0 0 12 2z"></path></svg></span>
      <span class="lbl">GitHub</span><span class="ext" aria-hidden="true">↗</span>
    </a>
    <span class="slash" aria-hidden="true"></span>
    <a class="cap" href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn (opens in a new tab)">
      <span class="ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.5 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3 9h3v12H3zM9 9h2.9v1.7c.4-.8 1.4-1.9 3.3-1.9 3.4 0 3.8 2.2 3.8 5V21h-3v-6.3c0-1.5 0-3.3-2-3.3s-2.1 1.5-2.1 3.2V21H9z"></path></svg></span>
      <span class="lbl">LinkedIn</span><span class="ext" aria-hidden="true">↗</span>
    </a>
  </div>
</header>

<style>
  .top { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 64px; padding: 8px 14px;
    background: color-mix(in srgb, var(--panel) 95%, transparent); box-shadow: 0 2px 10px -3px color-mix(in srgb, var(--navy) 28%, transparent); z-index: 5; }
  .tl { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .ttl { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .ttl-t { margin: 0; font-family: var(--f-disp); font-size: 1.6rem; font-style: italic; font-weight: 800; letter-spacing: -.01em; line-height: 1.2; white-space: nowrap; }
  .caps { display: flex; align-items: center; gap: 4px; }
  .cap { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px 0 5px; border-radius: 20px; text-decoration: none; font-weight: 700; font-size: .88rem;
    background: var(--panel-2); box-shadow: inset 0 0 0 1px var(--line); white-space: nowrap; }
  .cap .ic { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--navy-2); color: var(--panel); flex: none; }
  .cap .ext { color: var(--ink-2); font-weight: 600; }
  .cap:hover { box-shadow: inset 0 0 0 2px var(--cyan); }
  .slash { width: 1px; height: 22px; background: var(--line); rotate: 18deg; margin: 0 6px; flex: none; }
  @container app (min-width: 1024px) { .top { padding-inline: 18px 22px; } }
  @container app (max-width: 639px) {
    .top { min-height: 58px; padding: 6px 10px; }
    .ttl-t { font-size: 1.3rem; }
    .cap { padding: 0; width: 40px; justify-content: center; }
    .cap .lbl, .cap .ext { display: none; }
    .slash { margin: 0 2px; }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  // In-app back button. document.referrer doesn't change on client-side navigations,
  // so count in-site steps instead: forward adds one, back removes one.
  // Lives in TopBar (on every page) so steps taken from Home are counted too.
  let depth = 0;
  document.addEventListener("astro:before-preparation", (e) => {
    const direction = (e as Event & { direction?: string }).direction;
    depth = direction === "back" ? Math.max(0, depth - 1) : depth + 1;
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest("[data-back]")) return;
    if (depth > 0) history.back();
    else navigate("/");
  });
</script>
