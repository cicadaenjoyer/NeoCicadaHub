---
import { isCurrent } from "../../scripts/nav";

const items = [
  {
    href: "/",
    label: "Home",
    icon: `<path d="M16 4 3 15h4v12h7v-8h4v8h7V15h4z" fill="currentColor"/><path d="M14 27v-8h4v8" fill="#fff" opacity=".9"/>`,
  },
  {
    href: "/projects/",
    label: "Projects",
    icon: `<path d="M3 8a2 2 0 0 1 2-2h7l3 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" fill="currentColor"/><path d="M7 14h18v2H7zm0 5h12v2H7z" fill="#fff" opacity=".9"/>`,
  },
  {
    href: "/work/",
    label: "Work",
    icon: `<path d="M12 5h8a2 2 0 0 1 2 2v3h-3V8h-6v2h-3V7a2 2 0 0 1 2-2z" fill="currentColor"/><rect x="3" y="10" width="26" height="17" rx="2.5" fill="currentColor"/><path d="M3 17h26v2H3z" fill="#fff" opacity=".9"/><rect x="14" y="15.5" width="4" height="5" rx="1" fill="currentColor" stroke="#fff" stroke-width="1.4"/>`,
  },
  {
    href: "/about/",
    label: "About",
    icon: `<rect x="3" y="6" width="26" height="20" rx="3" fill="currentColor"/><circle cx="11.5" cy="14" r="3.5" fill="#fff"/><path d="M5.8 23c.8-3.4 3-5 5.7-5s4.9 1.6 5.7 5z" fill="#fff"/><path d="M19 12h7v2h-7zm0 5h5v2h-5z" fill="#fff" opacity=".9"/>`,
  },
  {
    href: "/contact/",
    label: "Contact",
    icon: `<path d="M16 4C8.8 4 3 8.8 3 14.6c0 3.3 1.8 6.2 4.6 8.1L6.2 28l6.2-3.4c1.2.3 2.3.4 3.6.4 7.2 0 13-4.8 13-10.6S23.2 4 16 4z" fill="currentColor"/><circle cx="10.5" cy="14.6" r="1.8" fill="#fff"/><circle cx="16" cy="14.6" r="1.8" fill="#fff"/><circle cx="21.5" cy="14.6" r="1.8" fill="#fff"/>`,
  },
];
const path = Astro.url.pathname;
---

<nav class="dock" aria-label="Main" transition:persist="dock">
  <div class="dock-in">
    {items.map((it) => (
      <a href={it.href} data-dock aria-current={isCurrent(it.href, path) ? "page" : undefined}>
        <svg viewBox="0 0 32 32" aria-hidden="true" set:html={it.icon} />
        {it.label}
      </a>
    ))}
  </div>
</nav>

<script>
  import { isCurrent } from "../../scripts/nav";
  // The dock persists across navigations, so its current item is updated after each swap.
  document.addEventListener("astro:after-swap", () => {
    document.querySelectorAll<HTMLAnchorElement>("[data-dock]").forEach((a) => {
      if (isCurrent(a.getAttribute("href") ?? "", location.pathname)) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  });
</script>

<style>
  .dock {
    display: flex;
    justify-content: center;
    background: var(--panel);
    box-shadow: 0 -3px 12px -4px color-mix(in srgb, var(--navy) 30%, transparent);
    z-index: 5;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .dock-in {
    display: flex;
    width: 100%;
    max-width: 820px;
  }
  .dock a {
    flex: 1;
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 3px;
    min-height: 68px;
    padding: 8px 2px 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--navy);
    transition: background 0.15s;
  }
  .dock a + a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 24%;
    height: 52%;
    width: 1px;
    background: var(--line);
  }
  .dock svg {
    width: 28px;
    height: 28px;
    transition: translate 0.15s;
  }
  .dock a:hover {
    background: var(--panel-2);
  }
  .dock a:hover svg {
    translate: 0 -2px;
  }
  .dock a[aria-current="page"] {
    color: var(--cyan-2);
    background: linear-gradient(180deg, var(--cyan-soft), var(--panel) 85%);
  }
  .dock a[aria-current="page"]::after {
    content: "";
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 4px;
    border-radius: 0 0 4px 4px;
    background: var(--cyan);
  }
  @container app (min-width: 1024px) {
    .dock a {
      font-size: 0.86rem;
      min-height: 72px;
    }
    .dock svg {
      width: 30px;
      height: 30px;
    }
  }
  @container app (max-width: 639px) {
    .dock a {
      font-size: 0.72rem;
      min-height: 62px;
    }
    .dock svg {
      width: 26px;
      height: 26px;
    }
  }
</style>
