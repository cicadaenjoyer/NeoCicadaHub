---
import Button from "../ui/Button.astro";

interface Props {
  email: string;
}
const { email } = Astro.props;
---

<div class="opt" data-copy-root>
  <span class="oi">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="m3.5 6 8.5 7 8.5-7"></path>
    </svg>
  </span>
  <span>
    <b>
      <a class="mailto" href={`mailto:${email}`}>
        Email me
      </a>
    </b>
    <small class="mail" data-email>
      {email}
    </small>
  </span>
  <Button size="sm" data-copy-email>
    Copy address
  </Button>
</div>

<style>
  .mailto {
    text-decoration-color: color-mix(in srgb, var(--navy) 35%, transparent);
    text-underline-offset: 3px;
  }
  .opt small.mail[data-email] {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.86rem;
    color: var(--navy);
    user-select: all;
  }
</style>

<script>
  import { onPage } from "../../scripts/lifecycle";

  const RESET_MS = 2000;

  onPage("[data-copy-root]", (root) => {
    const button = root.querySelector<HTMLElement>("[data-copy-email]")!;
    const label = button.firstElementChild as HTMLElement;
    const email = root.querySelector<HTMLElement>("[data-email]")!;
    const original = label.textContent;
    let timer: number | undefined;

    button.addEventListener("click", async () => {
      try {
        if (!navigator.clipboard) throw new Error("Clipboard API unavailable");
        await navigator.clipboard.writeText(email.textContent?.trim() ?? "");
        label.textContent = "Copied!";
      } catch {
        // Clipboard blocked (insecure context, denied permission): select the address for a manual copy.
        const range = document.createRange();
        range.selectNodeContents(email);
        const selection = getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        label.textContent = "Selected, press Ctrl+C";
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => (label.textContent = original), RESET_MS);
    });
    return () => clearTimeout(timer);
  });
</script>
