---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Chip from "../ui/Chip.astro";
import Button from "../ui/Button.astro";
import JobDialog from "./JobDialog.astro";

interface Props { job: CollectionEntry<"jobs"> }
const { job } = Astro.props;
const j = job.data;
---
<div class="panel job">
  <span class="logo"><Image src={j.logo} alt={`${j.org} logo`} width={152} /></span>
  <div class="txt">
    <div class="hd"><b>{j.title}</b><Chip tone={j.current ? "now" : undefined}>{j.current ? "Current" : "Previous"}</Chip></div>
    <div class="org">{j.org}</div>
    <p>{j.desc}</p>
  </div>
  <Button data-job-open={job.id} aria-haspopup="dialog">Details</Button>
</div>
<JobDialog job={job} />

<style>
  .job { display: grid; grid-template-columns: 76px minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 12px 16px 12px 12px; }
  .job .logo { width: 76px; height: 76px; }
  .txt { min-width: 0; }
  .hd { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .hd b { font-size: 1.08rem; font-weight: 800; }
  .org { color: var(--ink-2); font-weight: 700; font-size: .88rem; }
  .txt p { margin: 4px 0 0; font-size: .9rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-width: 72ch; }
  @container app (max-width: 639px) {
    .job { grid-template-columns: 56px minmax(0, 1fr); padding: 12px; }
    .job .logo { width: 56px; height: 56px; }
    .job > :global(.btn) { grid-column: 1 / -1; width: 100%; }
  }
</style>

<script>
  import { onPage } from "../../scripts/lifecycle";

  // Native <dialog>: showModal() gives focus trapping, Esc to close, an inert page behind it,
  // and focus returns to the Details button on close.
  onPage("[data-job-open]", (btn) => {
    const dialog = document.getElementById(`job-${btn.dataset.jobOpen}`) as HTMLDialogElement | null;
    if (!dialog) return;
    btn.addEventListener("click", () => dialog.showModal());
    dialog.addEventListener("click", (e) => {
      // A click on the dialog element itself is a click on the backdrop.
      if (e.target === dialog || (e.target as Element).closest("[data-close]")) dialog.close();
    });
    return () => {
      if (dialog.open) dialog.close();
    };
  });
</script>
