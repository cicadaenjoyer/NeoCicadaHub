---
import { getCollection } from "astro:content";
import AppShell from "../../layouts/AppShell.astro";
import ProjectsView from "../../components/projects/ProjectsView.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const active = projects[0]!;
---
<AppShell screen="projects" title="Projects" pageTitle="Projects · Abraham Hernandez" description="Projects built by Abraham Hernandez: Tabi, a C database system and a D&D dice store." canonical={`/projects/${active.id}/`}>
  <ProjectsView projects={projects} active={active} />
</AppShell>
